rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() < 80;
    }

    match /rsvps/{id} {
      allow create: if validName()
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 20
        && request.resource.data.attending is bool
        && request.resource.data.pax is int
        && request.resource.data.pax >= 0
        && request.resource.data.pax <= 20
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 400
        && request.resource.data.keys().hasOnly(['name', 'phone', 'attending', 'pax', 'notes', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /attendancePublic/{id} {
      allow read: if true;
      allow create: if validName()
        && request.resource.data.attending is bool
        && request.resource.data.pax is int
        && request.resource.data.pax >= 0
        && request.resource.data.pax <= 20
        && request.resource.data.keys().hasOnly(['name', 'attending', 'pax', 'createdAt']);
      allow update, delete: if false;
    }

    match /wishes/{id} {
      allow read: if true;
      allow create: if validName()
        && request.resource.data.message is string
        && request.resource.data.message.size() > 1
        && request.resource.data.message.size() <= 400
        && request.resource.data.keys().hasOnly(['name', 'message', 'createdAt']);
      allow update, delete: if false;
    }
  }
}
